# Reddit API Credentials - ENCRYPTED FOR SECURITY
# Access via SecretManager.get_secret("REDDIT_PUBLIC") and SecretManager.get_secret("REDDIT_SECRET")

# Database - ENCRYPTED FOR SECURITY
# Access via SecretManager.get_secret("DATABASE_URL")

# LLM Configuration (OpenRouter) - ENCRYPTED FOR SECURITY
# Access via SecretManager.get_secret("OPENROUTER_API_KEY")
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# OpenAI API Configuration - ENCRYPTED FOR SECURITY
# Access via SecretManager.get_secret("OPENAI_API_KEY")

# Pipeline Settings
DEFAULT_SUBREDDITS='["productivity", "tools"]'
DEFAULT_LIMIT=10
BATCH_SIZE=5

# Logging
LOG_LEVEL=INFO

# =============================================================================
# REDIS CONFIGURATION (IdeaBrowser Validation Cache)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# GitHub API Configuration - ENCRYPTED FOR SECURITY
# Access via SecretManager.get_secret("GITHUB_TOKEN")

# =============================================================================
# PRODUCTHUNT API Configuration - ENCRYPTED FOR SECURITY
# =============================================================================
# Access via SecretManager.get_secret("PRODUCTHUNT_API_KEY") and SecretManager.get_secret("PRODUCTHUNT_API_SECRET")
PRODUCTHUNT_REDIRECT_URI=https://localhost

# =============================================================================
# DATAFORSEO API Configuration (Keyword Research) - ENCRYPTED FOR SECURITY
# =============================================================================
# Access via SecretManager.get_secret("DATAFORSEO_LOGIN") and SecretManager.get_secret("DATAFORSEO_PASSWORD")
DATAFORSEO_API_URL=https://api.dataforseo.com
DATAFORSEO_LOCATION=United States
DATAFORSEO_LANGUAGE=English
DATAFORSEO_MIN_SEARCH_VOLUME=10
