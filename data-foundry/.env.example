# Database
DATABASE_URL=postgresql://user:password@localhost:5432/data_foundry

# Redis
REDIS_URL=redis://localhost:6379/0

# Stripe Billing - Data Foundry Metered Billing (P1-003)
# Core API Keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Meter IDs (for reference - meters are linked to prices)
STRIPE_AI_LABELS_METER_ID=mtr_test_61TredShNArNUpwZU41GgBK1ooXYF9Q0
STRIPE_HUMAN_AUDITS_METER_ID=mtr_test_61Tree9MgWnQF7Qum41GgBK1ooXYF8Fc

# Stripe Meter Events (for v2/billing/meter_event_stream API)
STRIPE_AI_LABEL_METER_EVENT=ai_labels
STRIPE_HUMAN_AUDIT_METER_EVENT=human_audits

# Gold Tier Pricing ($0.08/label, $0.04/audit, $99/month platform fee)
STRIPE_GOLD_AI_LABELS_PRICE_ID=price_1SiGsmGgBK1ooXYFiTaAJTsg
STRIPE_GOLD_HUMAN_AUDITS_PRICE_ID=price_1SiGsoGgBK1ooXYF7uXECzwT
STRIPE_GOLD_PLATFORM_FEE_PRICE_ID=price_1SiGStGgBK1ooXYFOQWpLTGw

# Silver Tier Pricing ($0.10/label, $0.04/audit, $49/month platform fee)
STRIPE_SILVER_AI_LABELS_PRICE_ID=price_1SiGspGgBK1ooXYFBeBkADUT
STRIPE_SILVER_HUMAN_AUDITS_PRICE_ID=price_1SiGsqGgBK1ooXYFKTKJB5VQ
STRIPE_SILVER_PLATFORM_FEE_PRICE_ID=price_1SiGSvGgBK1ooXYFlDQW8u1T

# Bronze Tier Pricing ($0.12/label, $0.04/audit, $0/month platform fee)
STRIPE_BRONZE_AI_LABELS_PRICE_ID=price_1SiGssGgBK1ooXYFpYphIB8D
STRIPE_BRONZE_HUMAN_AUDITS_PRICE_ID=price_1SiGsuGgBK1ooXYFVvPFQMeE
STRIPE_BRONZE_PLATFORM_FEE_PRICE_ID=price_1SiGSxGgBK1ooXYFz0LoLGCA

# Stripe Meter Event Configuration (Optional)
STRIPE_METER_EVENT_RETRY_ATTEMPTS=5
STRIPE_METER_EVENT_BATCH_SIZE=100

# AI Provider API Keys (for LiteLLM)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=ant-...
AZURE_API_KEY=...
AZURE_API_BASE=...
AZURE_API_VERSION=...

# Google AI (Gemini)
GOOGLE_API_KEY=...

# Cohere
COHERE_API_KEY=...

# LiteLLM Configuration
LITELLM_LOGGING=true
LITELLM_CACHE_TTL=3600
LITELLM_REQUEST_TIMEOUT=30

# Model Configuration
PRIMARY_MODEL=gpt-4o
FALLBACK_MODELS=claude-3-5-sonnet,gpt-4o-mini
MODEL_LIST=gpt-4o,claude-3-5-sonnet,gpt-4o-mini,gpt-3.5-turbo

# Cost Tracking
ENABLE_COST_TRACKING=true
COST_TRACKING_CURRENCY=USD
BILLING_PRECISION=6

# Label Studio
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_API_KEY=...

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment
ENVIRONMENT=development
DEBUG=true

# Week 1: Data Validation + Database Optimization
ENABLE_DATA_VALIDATION=true
MIN_QUALITY_SCORE=0.5
STAGING_DIRECTORY=data_foundry_staging

# Week 2: A/B Testing Framework
ENABLE_AB_TESTING=false
AB_TEST_RATIO=0.5
AB_TEST_NAME=validation_strategy_v1

# =============================================================================
# AML (Anti-Money Laundering) Service Configuration
# =============================================================================
# Core AML Service Settings
# Enable or disable the entire AML service functionality
ENABLE_AML_SERVICE=true

# AI confidence threshold for AML classifications (0.0-1.0)
# Transactions with AI confidence below this will be flagged for human review
AML_AI_CONFIDENCE_THRESHOLD=0.6

# Comma-separated list of available risk levels for AML classification
AML_RISK_LEVELS=LOW,MEDIUM,HIGH,CRITICAL

# Default risk level when classification is uncertain
# Must be one of the values in AML_RISK_LEVELS
AML_DEFAULT_RISK_LEVEL=MEDIUM

# -----------------------------------------------------------------------------
# Kappa Agreement Configuration (Inter-rater Reliability)
# -----------------------------------------------------------------------------
# Cohen's Kappa threshold for acceptable inter-rater agreement (0.0-1.0)
# 0.70 = Substantial agreement (recommended for AML compliance)
AML_KAPPA_THRESHOLD=0.70

# Kappa score interpretation ranges (JSON format)
# Maps interpretation labels to (min, max) value ranges
# AML_KAPPA_INTERPRETATION={"POOR": [0.0, 0.20], "FAIR": [0.20, 0.40], "MODERATE": [0.40, 0.60], "SUBSTANTIAL": [0.60, 0.80], "PERFECT": [0.80, 1.0]}

# -----------------------------------------------------------------------------
# Expert Review Configuration
# -----------------------------------------------------------------------------
# Number of expert reviews required for AML decisions
# Higher values increase accuracy but reduce throughput
AML_EXPERT_REQUIRED_REVIEWS=2

# Whether expert agreement is required for final classification
# true = all experts must agree, false = majority vote
AML_EXPERT_AGREEMENT_REQUIRED=true

# -----------------------------------------------------------------------------
# Audit and Compliance Settings
# -----------------------------------------------------------------------------
# Enable audit report generation for AML activities
# Required for regulatory compliance in most jurisdictions
AML_AUDIT_REPORT_ENABLED=true

# Enable regulatory flag tracking and alerts
# Tracks SAR (Suspicious Activity Report) requirements
AML_REGULATORY_FLAGS_ENABLED=true

# -----------------------------------------------------------------------------
# Performance and Processing Settings
# -----------------------------------------------------------------------------
# Batch size for bulk AML data insertions (must be > 0)
AML_BATCH_INSERT_SIZE=1000

# Timeout in seconds for AML labeling operations (must be > 0)
AML_LABELING_TIMEOUT_SECONDS=30

# Maximum size of the AML review queue (must be > 0)
# Prevents memory issues with large backlogs
AML_REVIEW_QUEUE_MAX_SIZE=10000